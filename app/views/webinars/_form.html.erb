<%= form_with(model: webinar, class: "contents") do |form| %>
  <%= render_form_errors(webinar) %>

  <!-- Переводимые поля с вкладками (автоматически подтягивают переводы из activerecord.attributes или common) -->
  <%= translated_fields(form, {
    title: { type: :text_field },
    description: { type: :text_area, rows: 5 }
  }, locales: @locales) %>

  
  <!-- Компонент повторения RecurrenceUi -->
  <div class="my-2">
    <%= render RecurrenceUi::RecurrencePickerComponent.new(
      record: webinar,
      form: form,
      week_start: 0,
      enabled_rule_types: %w[daily weekly monthly_by_day_of_month monthly_by_weekday yearly_by_day_of_month ]
    )   %>
  </div>

  <!-- Кнопки действия с переводами -->
  <div class="flex items-center justify-end gap-3">
    <%= link_to t('common.actions.cancel'), webinars_path, class: "app-btn-secondary" %>
    <%= form.submit t('common.actions.save'), class: "app-btn-primary" %>
  </div>
<% end %>