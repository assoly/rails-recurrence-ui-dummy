<% content_for :title, "Вебинары" %>

<div class="w-full max-w-5xl mx-auto py-8 space-y-6">
  <% if notice.present? %>
    <div class="p-4 text-sm rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400" id="notice">
      <%= notice %>
    </div>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="text-3xl font-bold tracking-tight">Вебинары</h1>
    <%= link_to "Новый вебинар", new_webinar_path, class: "app-btn-primary" %>
  </div>

  <div id="webinars" class="space-y-4">
    <% if @webinars.any? %>
      <% @webinars.each do |webinar| %>
        <div class="space-y-3">
          <%= render webinar %>
          <div class="flex items-center justify-end gap-2 pr-1">
            <%= link_to "Просмотр", webinar, class: "app-btn-secondary !py-1.5 !px-3 !text-xs" %>
            <%= link_to "Изменить", edit_webinar_path(webinar), class: "app-btn-secondary !py-1.5 !px-3 !text-xs" %>
            <%= button_to "Удалить", webinar, method: :delete, class: "app-btn-secondary !bg-red-500/10 !text-red-600 dark:!text-red-400 !border-red-500/20 hover:!bg-red-500/20 !py-1.5 !px-3 !text-xs cursor-pointer", data: { turbo_confirm: "Вы уверены?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="app-card text-center py-10 text-[var(--app-text-muted)]">
        Вебинары не найдены.
      </div>
    <% end %>
  </div>
</div>