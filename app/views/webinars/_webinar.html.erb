<div id="<%= dom_id webinar %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= webinar.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= webinar.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Starts at:</strong>
    <%= webinar.starts_at %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Finishes at:</strong>
    <%= webinar.finishes_at %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Time zone name:</strong>
    <%= webinar.time_zone_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Schedule json:</strong>
    <%= webinar.schedule_json %>
  </div>
</div>
