<div class="w-full max-w-7xl mx-auto px-2 sm:px-4 py-6 space-y-6" data-controller="calendar">
  
  <!-- Верхняя панель: Переключение модулей -->
  <div class="app-card !p-4 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
    <nav class="flex flex-wrap items-center gap-2">
      <%= link_to t('calendar.nav.all_events'), calendar_path, class: "app-btn-primary !py-1.5 !px-3 text-xs" %>
      <%= link_to t('calendar.nav.events'), events_path, class: "app-btn-secondary !py-1.5 !px-3 text-xs" if defined?(Event) %>
      <%= link_to t('calendar.nav.tasks'), tasks_path, class: "app-btn-secondary !py-1.5 !px-3 text-xs" if defined?(Task) %>
      <%= link_to t('calendar.nav.webinars'), webinars_path, class: "app-btn-secondary !py-1.5 !px-3 text-xs" if defined?(Webinar) %>
    </nav>

    <!-- Легенда -->
    <div class="flex items-center gap-3 text-xs font-medium">
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span> <%= t('calendar.legend.events') %></span>
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span> <%= t('calendar.legend.tasks') %></span>
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-purple-600"></span> <%= t('calendar.legend.webinars') %></span>
    </div>
  </div>

  <!-- Контейнер календаря FullCalendar -->
  <div class="app-card p-4">
    <div data-calendar-target="container"></div>
  </div>
</div>