<div class="max-w-md mx-auto app-card mt-8">
  <h2 class="app-heading-1 !text-2xl text-center"><%= t('devise.sessions.sign_in', default: 'Вход в систему') %></h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, class: "app-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "app-input" %>
    </div>

    <div>
      <%= f.label :password, class: "app-label" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "app-input" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "app-checkbox" %>
        <%= f.label :remember_me, class: "text-sm text-[var(--app-text-main)] cursor-pointer" %>
      </div>
    <% end %>

    <div class="pt-2">
      <%= f.submit t('devise.sessions.sign_in', default: 'Войти'), class: "app-btn-primary w-full" %>
    </div>
  <% end %>

  <div class="mt-4 text-center text-xs text-[var(--app-text-muted)] space-y-1">
    <%= render "devise/shared/links" %>
  </div>
</div>