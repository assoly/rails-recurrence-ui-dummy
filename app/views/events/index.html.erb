<% content_for :title, t('events.index.title') %>

<div class="w-full space-y-6">
  <% if notice.present? %>
    <p class="app-notice" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="app-heading-1"><%= t('events.index.title') %></h1>
    <%= link_to t('events.index.add_new'), new_event_path, class: "app-btn-primary" %>
  </div>

  <!-- Список событий -->
  <div id="events" class="space-y-4">
    <% if @events.any? %>
      <% @events.each do |event| %>
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center p-5 rounded-xl bg-[var(--app-bg-card)] border border-[var(--app-border-color)] shadow-sm gap-4 transition-all hover:border-gray-400 dark:hover:border-slate-600">
          <div class="w-full">
            <%= render event %>
          </div>
          
          <div class="w-full sm:w-auto flex flex-row sm:flex-col gap-2 shrink-0 self-end sm:self-center">
            <%= link_to t('common.actions.show'), event_path(event), class: "app-btn-secondary !py-1.5 !px-3 text-xs text-center" %>
            <%= link_to t('common.actions.edit'), edit_event_path(event), class: "app-btn-secondary !py-1.5 !px-3 text-xs text-center" %>
            <%= button_to t('common.actions.destroy'), event_path(event), method: :delete, class: "app-btn-danger !py-1.5 !px-3 text-xs text-center", data: { turbo_confirm: t('common.confirm_delete') } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="p-10 text-center rounded-xl border border-dashed border-[var(--app-border-color)] text-[var(--app-text-muted)]">
        <%= t('events.index.empty') %>
      </div>
    <% end %>
  </div>
</div>