<% content_for :title, t('events.edit.title') %>

<div class="md:w-2/3 w-full mx-auto">
  <h1 class="app-heading-1"><%= t('events.edit.title') %></h1>

  <%= render "form", event: @event %>

  <div class="app-actions-group">
    <%= link_to t('common.actions.show'), event_path(@event), class: "app-btn-secondary" %>
    <%= link_to t('events.actions.back_to_list'), events_path, class: "app-btn-secondary" %>
  </div>
</div>