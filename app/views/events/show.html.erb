<% content_for :title, @event.title %>

<div class="max-w-3xl mx-auto w-full space-y-6">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 dark:bg-green-950/40 text-green-600 dark:text-green-400 font-medium rounded-md inline-block border border-green-200 dark:border-green-900" id="notice"><%= notice %></p>
  <% end %>

  <!-- Главная карточка события -->
  <div class="p-6 rounded-2xl bg-[var(--app-bg-card)] border border-[var(--app-border-color)] shadow-sm space-y-6">
    
    <!-- 1. H1 Заголовок самого события -->
    <div>
      <h1 class="text-3xl font-extrabold text-[var(--app-text-main)]"><%= @event.title %></h1>
    </div>
    <!-- 3. Описание события (хранится в HTML, выводим с форматированием) -->
    <div>
      <div class="text-[var(--app-text-main)] leading-relaxed prose dark:prose-invert max-w-none">
        <%= @event.description.present? ? sanitize(@event.description) : "—" %>
      </div>
    </div>

    <!-- 4 & 5. Дата и время начала / окончания события -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-[var(--app-border-color)]">
      <div>
        <span class="block text-xs font-semibold uppercase text-[var(--app-text-muted)] tracking-wider mb-1"><%= t('activerecord.attributes.event.start_at') %></span>
        <span class="text-[var(--app-text-main)]   text-sm font-medium">
          <%= @event.formatted_start_time(zone_type = :event, show_zone: true) %>
        </span>
      </div>
      <div>
        <span class="block text-xs font-semibold uppercase text-[var(--app-text-muted)] tracking-wider mb-1"><%= t('activerecord.attributes.event.end_at') %></span>
        <span class="text-[var(--app-text-main)]   text-sm font-medium">
                    <%= @event.formatted_end_time(zone_type = :event, show_zone: true) %>

        </span>
      </div>
    </div>


    <!-- 6 & 7. Часовой пояс и Длительность одного события -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-[var(--app-border-color)]">
      <div>
        <span class="block text-xs font-semibold uppercase text-[var(--app-text-muted)] tracking-wider mb-1"><%= t('activerecord.attributes.event.time_zone') %></span>
        <span class="text-[var(--app-text-main)] text-sm font-medium">
          <%= @event.time_zone.presence || Time.zone.name %>
        </span>
      </div>
      <div>
        <span class="block text-xs font-semibold uppercase text-[var(--app-text-muted)] tracking-wider mb-1"><%= t('activerecord.attributes.event.duration') %></span>
        <span class="text-[var(--app-text-main)] text-sm font-medium">
          <%= @event.formatted_duration %> 
        </span>
      </div>
    </div>
    <!-- 2. Правило повторения события -->
    <div>
      <span class="block text-xs font-semibold uppercase text-[var(--app-text-muted)] tracking-wider mb-1"><%= t('events.show.rule_label') %></span>
         <%= @event.summary.to_s %>
    </div>
    <!-- 8. Ближайшие пять событий (occurrences) -->
    <div class="p-3.5 rounded-lg bg-[var(--app-bg-nav)] border border-[var(--app-border-color)]">
      <span class="app-label-muted mb-2 flex items-center gap-1.5">
        <span>📅</span> <%= t('events.show.upcoming_occurrences', count: 5) %>:
      </span>
      
      <% occurrences = @event.respond_to?(:formatted_upcoming_occurrences) ? @event.formatted_upcoming_occurrences(5, :event, show_end_time: true) : [] %>
      
      <% if occurrences.any? %>
        <ul class="divide-y divide-[var(--app-border-color)] rounded-xl border border-[var(--app-border-color)] bg-[var(--app-bg-card)] overflow-hidden">
          <% occurrences.each_with_index do |formatted_occ, idx| %>
            <li class="flex justify-between items-center px-4 py-2.5 text-sm">
              <span class="font-medium text-[var(--app-text-main)]">#<%= idx + 1 %></span>
              <span class="text-indigo-600 dark:text-indigo-400 font-semibold"><%= formatted_occ %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-[var(--app-text-muted)] italic"><%= t('events.show.no_upcoming_occurrences') %></p>
      <% end %>
    </div>
  </div>

  <!-- 9. Кнопки для редактирования, удаления и перехода на список всех событий -->
  <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
    <div class="flex items-center gap-2">
      <%= link_to t('common.actions.edit'), edit_event_path(@event), class: "rounded-md px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm transition-colors shadow-sm" %>
      <%= button_to t('common.actions.destroy'), @event, method: :delete, class: "rounded-md px-4 py-2 text-white bg-red-600 hover:bg-red-500 font-medium text-sm cursor-pointer transition-colors shadow-sm", data: { turbo_confirm: t('common.confirm_delete') } %>
    </div>
    
    <div>
      <%= link_to t('calendar.nav.all_events'), events_path, class: "rounded-md px-4 py-2 border border-[var(--app-border-color)] bg-[var(--app-bg-card)] text-[var(--app-text-main)] hover:opacity-80 font-medium text-sm transition-colors shadow-sm" %>
    </div>
  </div>
</div>