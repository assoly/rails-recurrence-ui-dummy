<% content_for :title, "Showing event" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="app-notice" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="app-heading-1">Showing event</h1>

  <%= render @event %>

  <div class="app-actions-group">
    <%= link_to "Edit this event", edit_event_path(@event), class: "app-btn-secondary" %>
    <%= link_to "Back to events", events_path, class: "app-btn-secondary" %>
    <%= button_to "Destroy this event", @event, method: :delete, form_class: "w-full sm:w-auto", class: "app-btn-danger", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>