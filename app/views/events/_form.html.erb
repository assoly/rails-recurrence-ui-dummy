<%= form_with(model: event, class: "contents") do |form| %>
  <% if event.errors.any? %>
    <div class="app-error-box" role="alert">
      <div class="flex items-center gap-2 font-semibold mb-2">
        <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
        </svg>
        <h2><%= pluralize(event.errors.count, "ошибка", "ошибки", "ошибок") %> помешали сохранить событие:</h2>
      </div>

      <ul class="list-disc list-inside space-y-1">
        <% event.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Название события %>
  <div class="my-5">
    <%= form.label :title, class: "app-label" %>
    <%= form.text_field :title, class: ["app-input", ("app-input-error" if event.errors[:title].any?)] %>
  </div>

  <%# Описание события %>
  <div class="my-5">
    <%= form.label :description, class: "app-label" %>
    <%= form.text_area :description, rows: 3, class: ["app-input", ("app-input-error" if event.errors[:description].any?)] %>
  </div>

  <%# Время начала и окончания события %>
  <div class="my-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= form.label :start_at, class: "app-label" %>
      <%= form.datetime_field :start_at, class: ["app-input", ("app-input-error" if event.errors[:start_at].any?)] %>
    </div>

    <div>
      <%= form.label :end_at, class: "app-label" %>
      <%= form.datetime_field :end_at, class: ["app-input", ("app-input-error" if event.errors[:end_at].any?)] %>
    </div>
  </div>

  <%# Выбор часового пояса (Time Zone) %>
  <div class="my-5">
    <%= form.label :time_zone, class: "app-label" %>
    <%= form.time_zone_select :time_zone, 
          ActiveSupport::TimeZone.us_zones, 
          { default: event.time_zone.presence || Time.zone.name }, 
          { class: ["app-input cursor-pointer", ("app-input-error" if event.errors[:time_zone].any?)] } %>
  </div>

  <%# Компонент повторения гема RecurrenceUi %>
  <div class="my-6">
    <%= render RecurrenceUi::PickerComponent.new(
          form: form, 
          record: event, 
          field_name: :recurring_rules
        ) %>
  </div>

  <%# Кнопки действия %>
  <div class="mt-8 flex items-center justify-end gap-3">
    <%= link_to "Отмена", events_path, class: "app-btn-secondary" %>
    <%= form.submit class: "app-btn-primary" %>
  </div>
<% end %>