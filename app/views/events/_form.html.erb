<%= form_with(model: event, class: "contents") do |form| %>
  <%= render_form_errors(event) %>

  <!-- Переводимые поля с вкладками (автоматически подтягивают переводы из activerecord.attributes или common) -->
  <%= translated_fields(form, {
    title: { type: :text_field },
    description: { type: :text_area, rows: 5 }
  }, locales: @locales) %>

  
  <!-- Компонент повторения RecurrenceUi -->
  <div class="my-2">
    <%= render RecurrenceUi::RecurrencePickerComponent.new(form: form,record: event) %>
  </div>

  <!-- Кнопки действия с переводами -->
  <div class="flex items-center justify-end gap-3">
    <%= link_to t('common.actions.cancel', default: 'Отмена'), events_path, class: "app-btn-secondary" %>
    <%= form.submit t('common.actions.save', default: 'Сохранить'), class: "app-btn-primary" %>
  </div>
<% end %>