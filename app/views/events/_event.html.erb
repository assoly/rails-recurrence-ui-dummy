<div id="<%= dom_id event %>" class="w-full space-y-3 text-[var(--app-text-main)]">
  <!-- Заголовок -->
  <h3 class="text-xl font-bold tracking-tight">
    <%= link_to event.title, event, class: "hover:underline hover:text-blue-600 transition-colors" %>
  </h3>

  <!-- Описание правила повторения -->
  <div class="flex items-center gap-2 text-sm">
    <span class="text-xs font-semibold uppercase text-[var(--app-text-muted)] tracking-wider">Правило:</span>
    <span class="px-2.5 py-1 rounded-md text-xs font-medium bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
      <%= RecurrenceUi::PickerComponent.new(record: event, field_name: :recurring_rules).recurrence_summary %>
    </span>
  </div>

  <!-- Ближайшие 5 событий для конкретного эвента (IceCube) -->
  <div class="mt-2 p-3 rounded-lg bg-[var(--app-bg-nav)] border border-[var(--app-border-color)]">
    <span class="block text-xs font-semibold text-[var(--app-text-muted)] uppercase mb-2">
      📅 Ближайшие 5 повторений:
    </span>
    
    <% occurrences = event.respond_to?(:upcoming_occurrences) ? event.upcoming_occurrences(5) : [] %>
    <% if occurrences.any? %>
      <div class="flex flex-wrap gap-1.5">
        <% occurrences.each do |occ| %>
          <span class="inline-block px-2 py-0.5 text-xs font-mono rounded bg-[var(--app-bg-card)] border border-[var(--app-border-color)]">
            <%= occ.to_time.strftime("%d.%m.%Y %H:%M") %>
          </span>
        <% end %>
      </div>
    <% else %>
      <p class="text-xs text-[var(--app-text-muted)] italic">Нет запланированных повторений</p>
    <% end %>
  </div>
</div>