<div id="<%= dom_id event %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= event.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= event.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Recurring rules:</strong>
    <%= event.recurring_rules %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Recurrence summary:</strong>
    <%= RecurrenceUi::PickerComponent.new(record: event, field_name: :recurring_rules).recurrence_summary %>  
  </div>


</div>
