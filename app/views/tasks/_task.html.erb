<div id="<%= dom_id task %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= task.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Completed:</strong>
    <%= task.completed? ? "Yes" : "No" %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Due date:</strong>
    <%= task.due_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Recurrence data:</strong>
    <%= task.recurrence_data %>
  </div>
</div>
