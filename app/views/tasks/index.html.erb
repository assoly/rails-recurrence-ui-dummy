<div class="w-full max-w-4xl mx-auto py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Задачи</h1>
    <%= link_to "Новая задача", new_task_path, class: "app-btn-primary" %>
  </div>

  <div class="app-list">
    <% @tasks.each do |task| %>
      <div class="app-list-item">
        <div>
          <div class="font-medium"><%= task.title %></div>
          <div class="text-xs" style="color: var(--app-text-muted)">
            Дедлайн: <%= task.due_date&.strftime("%d.%m.%Y %H:%M") || "Не задан" %>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <%= link_to "Просмотр", task, class: "app-btn-secondary !py-1 !px-3 !text-xs" %>
        </div>
      </div>
    <% end %>
  </div>
</div>