<%= form_with(model: task, class: "contents") do |form| %>
  <% if task.errors.any? %>
    <div class="app-error-box" role="alert">
      <div class="flex items-center gap-2 font-semibold mb-2">
        <h2><%= pluralize(task.errors.count, "ошибка", "ошибки", "ошибок") %> помешали сохранить:</h2>
      </div>
      <ul class="list-disc list-inside space-y-1">
        <% task.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

<!-- Поле Title (String) -->
<%= translated_field(form, :title, locales: @locales) %>

<!-- Поле Description (HTML/Text) -->
<%= translated_field(form, :description, locales: @locales, type: :text_area) %>

  <%# Чекбокс %>
  <div class="my-5 flex items-center gap-3 p-3 app-card">
    <%= form.check_box :completed, class: "app-checkbox" %>
    <%= form.label :completed, class: "app-label !mb-0 cursor-pointer" %>
  </div>

  <%# Срок выполнения %>
  <div class="my-5">
    <%= form.label :due_date, class: "app-label" %>
    <%= form.datetime_field :due_date, class: ["app-input", ("app-input-error" if task.errors[:due_date].any?)] %>
  </div>

  <%# Компонент повторения гема RecurrenceUi %>
  <div class="my-6">
    <%= render RecurrenceUi::PickerComponent.new(
          form: form, 
          record: task, 
          field_name: :recurrence_data
        ) %>
  </div>

  <%# Действия %>
  <div class="mt-8 flex items-center justify-end gap-3">
    <%= link_to "Отмена", tasks_path, class: "app-btn-secondary" %>
    <%= form.submit class: "app-btn-primary" %>
  </div>
<% end %>