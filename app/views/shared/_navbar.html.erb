<header class="sticky top-0 z-30 border-b border-[var(--app-border-color)] bg-[var(--app-bg-nav)]/95 backdrop-blur">
  <div class="flex min-h-16 flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-8">

    <%# Левая часть: меню и часы %>
    <div class="flex min-w-0 items-center gap-3 sm:gap-4">

      <button
        type="button"
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-[var(--app-border-color)] text-xl hover:bg-[var(--app-bg-card)] lg:hidden"
        data-action="click->mobile-menu#toggle"
        aria-controls="app-sidebar"
        aria-expanded="false"
        aria-label="<%= t('navigation.open_menu', default: 'Open menu') %>"
      >
        ☰
      </button>

      <% raw_tz = current_user&.time_zone.presence || Time.zone.name %>
      <% iana_tz = ActiveSupport::TimeZone[raw_tz]&.tzinfo&.name || raw_tz %>

      <div
        class="flex min-w-0 items-center gap-2 sm:gap-3"
        data-controller="clock"
        data-clock-tz-value="<%= iana_tz %>"
      >
        <div class="font-mono text-sm font-bold tabular-nums sm:text-base"
             data-clock-target="time">
          --:--:--
        </div>

        <div
          class="hidden max-w-40 truncate rounded-md border border-[var(--app-border-color)] bg-[var(--app-bg-card)] px-2 py-1 text-xs font-medium text-[var(--app-text-muted)] sm:block"
          data-clock-target="zone"
          title="<%= iana_tz %>"
        >
          <%= iana_tz %>
        </div>
      </div>
    </div>

    <%# Правая часть: язык, пользователь и тема %>
    <div class="flex items-center gap-2 sm:gap-3">

      <%# Переключение локали %>
      <div
        class="flex items-center gap-1 rounded-lg border border-[var(--app-border-color)] bg-[var(--app-bg-card)] p-1"
        aria-label="<%= t('common.language') %>"
      >
        <% I18n.available_locales.each do |loc| %>
          <%= link_to loc.to_s.upcase,
            url_for(locale: loc),
            class: [
              "rounded-md px-2 py-1.5 text-xs font-semibold transition-colors",
              I18n.locale.to_s == loc.to_s ?
                "bg-[var(--app-btn-primary-bg)] text-white" :
                "text-[var(--app-text-muted)] hover:text-[var(--app-text-main)]"
            ].join(" "),
            aria: { current: I18n.locale.to_s == loc.to_s ? "page" : nil },
            title: loc.to_s.upcase %>
        <% end %>
      </div>

      <%# Аватар пользователя %>
      <% if user_signed_in? %>
        <% display_name = current_user.try(:name).presence || current_user.email %>
        <% avatar_letter = display_name.to_s.strip.first&.upcase || "?" %>

        <%= link_to edit_user_registration_path,
          class: "flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--app-btn-primary-bg)] font-bold text-white transition-opacity hover:opacity-80",
          title: display_name,
          aria: { label: t("navigation.profile") } do %>
          <%= avatar_letter %>
        <% end %>
      <% else %>
        <%= link_to new_user_session_path,
          class: "rounded-lg border border-[var(--app-border-color)] px-3 py-2 text-sm font-medium hover:bg-[var(--app-bg-card)]" do %>
          <%= t("devise.sessions.sign_in") %>
        <% end %>
      <% end %>

      <%# Переключатель темы %>
      <button 
        type="button" 
        data-controller="theme"
        data-action="click->theme#toggle"
        data-theme-target="button"
        aria-label="Переключить тему"
        aria-pressed="false"
        class="relative inline-flex h-8 w-14 shrink-0 cursor-pointer items-center justify-between rounded-full bg-gray-200 px-1.5 transition-colors duration-200 ease-in-out focus:outline-none dark:bg-gray-700 shadow-inner"
      >
        <%# ☀️ Иконка солнца (слева) %>
        <svg class="h-4 w-4 text-gray-200 dark:text-gray-400 z-10 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
        </svg>

        <%# 🌙 Иконка луны (справа) %>
        <svg class="h-4 w-4 text-gray-400 dark:text-gray-200 z-10 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"></path>
        </svg>

        <%# 🔵 Плавающий синий кружок-ползунок (абсолютное позиционирование по центру вертикали) %>
        <span class="absolute left-1 top-1 h-6 w-6 rounded-full bg-blue-600 shadow-md transition-transform duration-200 ease-in-out dark:translate-x-6 dark:bg-blue-500"></span>
      </button>
    </div>
  </div>
</header>