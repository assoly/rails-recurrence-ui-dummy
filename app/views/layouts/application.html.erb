<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>
      <%= content_for?(:title) ? yield(:title) : t('common.app_name', default: 'Dummy App') %>
    </title>

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script>
      if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

  </head>

  <body data-controller="theme" class="min-h-screen bg-[var(--app-bg-main)] text-[var(--app-text-main)]">
    <div
      class="min-h-screen lg:flex"
      data-controller="mobile-menu"
    >
      <%# Основное меню %>
      <%= render "shared/sidebar" %>

      <%# Правая часть приложения %>
      <div class="flex min-w-0 flex-1 flex-col">
        <%= render "shared/navbar" %>

        <main class="w-full flex-1 px-4 py-5 sm:px-6 lg:px-8">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>