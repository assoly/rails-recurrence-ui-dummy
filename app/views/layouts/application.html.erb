<!DOCTYPE html>
<html>
  <head>
    <title>Dummy</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
    <!-- Инициализация темы без задержки при загрузке -->
    <script>
      if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>

  <body class="min-h-screen">
    <main class="container mx-auto mt-10 px-5 flex flex-col">
      <!-- Панель управления (Языки и Тема) -->
      <nav class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-xl border border-[var(--app-border-color)] bg-[var(--app-bg-nav)] mb-6 shadow-sm">
        
        <!-- Динамический список языков по порядку из конфигурации -->
        <div class="flex items-center gap-2">
          <span class="font-bold text-sm">Язык / Language:</span>
          <% (I18n.available_locales || []).each do |loc| %>
            <%= link_to loc.to_s.upcase, 
                        url_for(locale: loc), 
                        class: "px-2 py-1 rounded text-sm transition-colors #{I18n.locale == loc ? 'font-bold bg-blue-600 text-white' : 'underline text-[var(--app-text-muted)] hover:text-[var(--app-text-main)]'}" %>
          <% end %>
        </div>

        <!-- Кнопка переключения темы -->
        <button type="button" 
                onclick="toggleTheme()" 
                class="px-3 py-1.5 text-xs font-medium rounded-md border border-[var(--app-border-color)] bg-[var(--app-bg-card)] text-[var(--app-text-main)] hover:opacity-80 transition-colors shadow-sm">
          🌙 / ☀️ Toggle Theme
        </button>
      </nav>

      <%= yield %>
    </main>

    <script>
      function toggleTheme() {
        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      }
    </script>
  </body>
</html>