<!DOCTYPE html>
<html>
  <head>
    <title>Dummy</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <main class="container mx-auto mt-28 px-5 flex">
    <nav class="flex gap-4 p-4 bg-gray-100 mb-6">
      <span class="font-bold">Язык / Language:</span>
      <%= link_to "RU", url_for(locale: :ru), class: "underline #{'font-bold text-blue-600' if I18n.locale == :ru}" %>
      <%= link_to "EN", url_for(locale: :en), class: "underline #{'font-bold text-blue-600' if I18n.locale == :en}" %>
      <%= link_to "JA", url_for(locale: :ja), class: "underline #{'font-bold text-blue-600' if I18n.locale == :ja}" %>
    </nav>
      <%= yield %>
    </main>
  </body>
</html>
